<Project Sdk="Microsoft.NET.Sdk">

  <!--
    PixelFlux.Core — everything that is not UI and not model inference:
    the domain model, the SQLite index, ingestion, hashing, EXIF, thumbnails/proxies,
    the job queue, revision sync, search, and non-destructive editing.

    Deliberately targets plain net10.0 (no platform TFM) so the same assembly serves the
    MAUI desktop app, unit tests, and any future headless worker. Anything that genuinely
    needs Windows lives behind an interface here and is implemented in the app.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PixelFlux.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="SixLabors.ImageSharp" />
    <PackageReference Include="MetadataExtractor" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PixelFlux.Storage\PixelFlux.Storage.csproj" />
  </ItemGroup>

  <!--
    The offline gazetteer, embedded rather than copied alongside the exe.

    Reverse geocoding has to happen without a network call — the app makes none, by design and
    by content policy — so the lookup table ships inside the assembly. Embedding rather than
    shipping a loose file means it cannot be lost when the build output is zipped or moved.
    Rebuild it with tools/build_gazetteer.py; source is GeoNames under CC BY 4.0, and the
    attribution file beside it must ship with any distribution.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Geo\gazetteer.bin" />
    <None Include="Geo\gazetteer-ATTRIBUTION.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PixelFlux.Tests" />
  </ItemGroup>

</Project>
